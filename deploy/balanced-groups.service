[Unit]
Description=balanced_groups HTTP API (familiarity matrix for joshsi.com group maker)
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=balanced-groups
WorkingDirectory=/var/lib/balanced-groups
EnvironmentFile=/etc/balanced-groups.env
ExecStart=/opt/balanced-groups/balanced-groups-server
Restart=always
RestartSec=2

# Hardening — the server only needs its state directory and a loopback socket.
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
